		"devdoc": {
			"kind": "dev",
			"methods": {
				"acceptOwnership()": {
					"details": "The new owner accepts the ownership transfer."
				},
				"claimNFT(uint256,address)": {
					"details": "尚未结算时可顺便结算；接收失败后也可单独调用 settleAuction，不阻塞卖家收入。"
				},
				"configureToken(address,address,uint256)": {
					"details": "新配置用于后续报价和出价，不重算已有出价的美元估值。"
				},
				"constructor": {
					"custom:oz-upgrades-unsafe-allow": "constructor"
				},
				"createAuction(address,uint256,uint256,uint256)": {
					"params": {
						"duration": "拍卖时长，单位为秒，最大 30 天。",
						"reservePriceUsd": "18 位精度美元起拍价；首次出价可以等于起拍价。"
					}
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"paused()": {
					"details": "Returns true if the contract is paused, and false otherwise."
				},
				"pendingOwner()": {
					"details": "Returns the address of the pending owner."
				},
				"proxiableUUID()": {
					"details": "Implementation of the ERC-1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."
				},
				"renounceOwnership()": {
					"details": "禁止放弃管理员，避免合约暂停后永远无法恢复。"
				},
				"transferOwnership(address)": {
					"details": "Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner. Setting `newOwner` to the zero address is allowed; this can be used to cancel an initiated ownership transfer."
				},
				"upgradeToAndCall(address,bytes)": {
					"custom:oz-upgrades-unsafe-allow-reachable": "delegatecall",
					"details": "Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."
				}
			},
			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"cancelAuction(uint256)": {
					"notice": "无人出价时卖家可取消；NFT 随后通过 claimNFT 领取。"
				},
				"claimNFT(uint256,address)": {
					"notice": "赢家领取成交 NFT，卖家领取取消/流拍 NFT；可指定兼容 ERC721 的接收地址。"
				},
				"configureToken(address,address,uint256)": {
					"notice": "添加或更新 token/USD 价格配置；更新保留启用状态及代币精度。"
				},
				"placeBid(uint256,address,uint256)": {
					"notice": "amount 为本次追加数量。同一账户退款前不能更换币种。"
				},
				"quoteUsd(address,uint256)": {
					"notice": "返回 18 位精度的美元估值；停用币种仍可查询。"
				},
				"setTokenEnabled(address,bool)": {
					"notice": "停用仅禁止新出价，不妨碍已有资金结算、退款和提现。"
				},
				"settleAuction(uint256)": {
					"notice": "到期后任何人均可结算；不调用价格源、卖家或赢家，也不转出 NFT。"
				},
				"withdrawBid(uint256,address)": {
					"notice": "非最高出价者可随时退款到指定地址，结算后仍然可退。"
				}
			},
			"version": 1
		}
	},
